# This file is automatically generated from traits.build
# package, via the file remake.yml.whisker:
# edit the file there (or the files that it includes).

library(targets)

# `qs` stores targets with qs2 rather than gzipped rds. The store is internal
# to targets -- the exported .rds that consumers read is unaffected -- and it
# is worth about a third of a rebuild, so it is used when qs2 is available and
# quietly skipped when it is not.
tar_option_set(
  packages = "traits.build",
  format = if (requireNamespace("qs2", quietly = TRUE)) "qs" else "rds"
)
{{#parallel}}

# Build datasets in parallel. Each worker is a separate R process, so this is
# worth its startup cost only for a full build, not a one-dataset rebuild.
tar_option_set(
  controller = crew::crew_controller_local(workers = {{workers}})
)
{{/parallel}}

list(

  # Configuration. Each is declared as a `format = "file"` target so that
  # editing the file rebuilds exactly what depends on it, and nothing else.
  tar_target(schema, get_schema()),

  tar_target(file_resource_metadata, "config/metadata.yml", format = "file"),
  tar_target(resource_metadata, get_schema(file_resource_metadata, I("metadata"))),

  tar_target(file_definitions, "config/traits.yml", format = "file"),
  tar_target(definitions, get_schema(file_definitions, I("traits"))),

  tar_target(file_unit_conversions, "config/unit_conversions.csv", format = "file"),
  tar_target(unit_conversions, get_unit_conversions(file_unit_conversions)),

  tar_target(file_taxon_list, "config/taxon_list.csv", format = "file"),
  tar_target(taxon_list, read_csv_char(file_taxon_list)),

  # Build each source
{{#dataset_ids}}
  tar_target(file_{{dataset_id}}_metadata, "{{path}}/{{dataset_id}}/metadata.yml", format = "file"),
  tar_target(file_{{dataset_id}}_data, "{{path}}/{{dataset_id}}/data.csv", format = "file"),
  tar_target({{dataset_id}}_config, dataset_configure(file_{{dataset_id}}_metadata, definitions)),
  tar_target({{dataset_id}}_raw, dataset_process(file_{{dataset_id}}_data, {{dataset_id}}_config, schema, resource_metadata, unit_conversions)),
  tar_target({{dataset_id}}, dataset_update_taxonomy({{dataset_id}}_raw, taxon_list)),

{{/dataset_ids}}
  # Version information. `git_SHA` is re-read on every run, because the commit
  # can change without any file the pipeline tracks changing. It is cheap, and
  # everything downstream of it is skipped when the SHA has not moved.
  tar_target(version_number, util_get_version(file_resource_metadata)),
  tar_target(git_SHA, util_get_SHA(), cue = tar_cue(mode = "always")),

  # Combine all the source into one resource. `build_add_version()` is folded in
  # here rather than given a target of its own: it takes no measurable time, so
  # splitting it bought no caching while costing a second copy of the whole
  # database in the store on every rebuild. The price is that a commit with no
  # data change now re-runs `bind_databases()`.
  tar_target(
    {{database_name}},
    build_add_version(
      austraits::bind_databases(
{{#dataset_ids}}
        {{dataset_id}},
{{/dataset_ids}}
        NULL
      ),
      version_number,
      git_SHA
    )
  ),

  # Save to file
  tar_target(
    file_{{database_name}},
    {
      dir.create("export/data/curr", FALSE, TRUE)
      saveRDS({{database_name}}, "export/data/curr/{{database_name}}.rds")
      "export/data/curr/{{database_name}}.rds"
    },
    format = "file"
  )
)
